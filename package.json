{
  "name": "qa-api-tests",
  "version": "1.0.0",
  "description": "API test suite (Postman + Newman) for a booking/payment REST API — QA portfolio of Roman Neklyudov.",
  "scripts": {
    "test:contracts": "node --test tests/repeated-read.test.cjs",
    "test": "newman run postman/booking-api.postman_collection.json --reporters cli,junit --reporter-junit-export reports/junit.xml",
    "test:ci": "newman run postman/booking-api.postman_collection.json --reporters cli,junit --reporter-junit-export reports/junit.xml"
  },
  "keywords": [
    "qa",
    "api-testing",
    "postman",
    "newman",
    "rest-api",
    "test-automation",
    "ci-cd"
  ],
  "author": "Roman Neklyudov <r0meo1@ya.ru>",
  "license": "MIT",
  "devDependencies": {
    "newman": "^6.1.3"
  },
  "overrides": {
    "handlebars": "4.7.9",
    "lodash": "4.18.1",
    "node-forge": "1.4.0",
    "qs": "6.16.0",
    "underscore": "1.13.8",
    "ip-address": "10.7.2",
    "flatted": "3.4.4",
    "jose": "4.15.9"
  }
}
